{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "30"
  },
  "permissions": {
    "allow": [
      "Edit(/audit/runs/**)",
      "Bash(node cloud/test.js)",
      "Bash(node tools/*-test.js)",
      "Bash(node .claude/skills/audit/merge.js *)",
      "Bash(node audit/runs/*)",
      "Bash(node -e *)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(java -version)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(firebase *)",
      "Bash(npx firebase *)",
      "Bash(gcloud *)",
      "Bash(*node*toast-*)",
      "Bash(*node*sync-toast*)",
      "Bash(*node*sync.js*)",
      "Bash(*node*functions/*)",
      "Bash(*GOOGLE_APPLICATION_CREDENTIALS*)",
      "Read(/.env)",
      "Read(/functions/.env)",
      "Read(/**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
