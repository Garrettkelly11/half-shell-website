{
  "rules": {
    ".read": false,
    ".write": false,
    "menu": {
      "serving": {
        ".read": true,
        ".write": false
      },
      "overrides": {
        ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
        ".write": false
      },
      "prices": {
        ".read": true,
        ".write": false
      },
      "happyHour": {
        ".read": true,
        ".write": false
      }
    },
    "audit-log": {
      ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
      ".write": false
    },
    "config": {
      "birthdayReward": {
        ".read": true,
        ".write": false
      }
    },
    "toastOrders": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'phone'",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'phone'",
        ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'phone'",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'dob', 'dobEditsUsed', 'phone', 'createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^ @]+@[^ @]+\\.[^ @]+$/)" },
          "dob": {
            ".validate": "newData.isString() && newData.val().matches(/^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && (!data.exists() || data.val() == newData.val() || (data.parent().child('dobEditsUsed').val() == 0 && newData.parent().child('dobEditsUsed').val() == 1))"
          },
          "dobEditsUsed": { ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() == 1) && (!data.exists() || newData.val() >= data.val())" },
          "phone": { ".validate": "newData.val() == auth.token.phone_number" },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "activeVisitId": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "visits": {
          "$visitId": {
            ".validate": "$visitId.length <= 40 && newData.hasChildren(['date', 'startedAt', 'lastChangedAt', 'source'])",
            "date": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && newData.val() >= '2026-02-03'" },
            "startedAt": { ".validate": "newData.isNumber()" },
            "lastChangedAt": { ".validate": "newData.isNumber()" },
            "closedAt": { ".validate": "newData.isNumber()" },
            "closeReason": { ".validate": "newData.val() == 'saved' || newData.val() == 'timeout' || newData.val() == 'backdated'" },
            "source": { ".validate": "newData.val() == 'manual'" },
            "ratePromptDismissed": { ".validate": "newData.isBoolean()" },
            "flightsLogged": {
              "$slug": {
                ".validate": "$slug.matches(/^[a-z0-9-]{1,60}$/)",
                "$oysterId": { ".validate": "$oysterId.matches(/^[a-z0-9-]{1,60}$/) && newData.val() == true" }
              }
            },
            "items": {
              "$oysterId": {
                ".validate": "$oysterId.matches(/^[a-z0-9-]{1,60}$/) && newData.hasChildren(['qty', 'addedAt'])",
                "qty": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99 && newData.val() % 1 == 0" },
                "rating": { ".validate": "newData.isNumber() && (newData.val() == 1 || newData.val() == 2 || newData.val() == 3 || newData.val() == 4 || newData.val() == 5)" },
                "twoWords": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "note": { ".validate": "newData.isString() && newData.val().length <= 280" },
                "addedAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "stamps": {
          "$stampId": {
            ".validate": "$stampId.length <= 60 && newData.hasChildren(['tier', 'seen'])",
            "tier": { ".validate": "newData.val() == 'single' || newData.val() == 'bronze' || newData.val() == 'silver' || newData.val() == 'gold' || newData.val() == 'pearl'" },
            "tierEarnedAt": {
              "$tier": { ".validate": "($tier == 'single' || $tier == 'bronze' || $tier == 'silver' || $tier == 'gold' || $tier == 'pearl') && newData.isNumber()" }
            },
            "seen": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "cards": {
          "$cardId": {
            ".validate": "$cardId.length <= 40 && newData.hasChildren(['last4', 'brand', 'addedAt'])",
            "last4": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
            "brand": { ".validate": "newData.val() == 'VISA' || newData.val() == 'MASTERCARD' || newData.val() == 'AMEX' || newData.val() == 'DISCOVER' || newData.val() == 'OTHER'" },
            "addedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "hereOn": {
          "$date": { ".validate": "$date.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && newData.isNumber()" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
