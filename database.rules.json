{
  "rules": {
    ".read": false,
    ".write": false,
    "menu": {
      "serving": {
        ".read": true,
        ".write": false
      },
      "overrides": {
        ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
        ".write": false
      }
    },
    "audit-log": {
      ".read": "auth != null && root.child('staff').child(auth.uid).exists()",
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
