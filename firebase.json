{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "cloud",
      "codebase": "cloud",
      "runtime": "nodejs22",
      "predeploy": [
        "node \"$RESOURCE_DIR/vendor-site.js\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "test.js",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env",
        ".env.*",
        ".secret.local"
      ]
    }
  ]
}
